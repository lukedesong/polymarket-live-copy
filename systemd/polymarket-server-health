#!/bin/sh
# Root-owned, argument-free bridge for the unprivileged maintenance unit.
# It reads the isolated cash-live runtime but cannot place, cancel, or redeem orders.
set -eu
umask 0022

exec /opt/polymarket-live/venv/bin/python \
  /usr/local/libexec/polymarket/server_health_heartbeat.py \
  --runtime-dir /srv/polymarket-live/runtime/server_health \
  --cd90-runtime-dir /srv/polymarket-live/runtime/cd90_live \
  --coordinator-path /srv/polymarket-live/runtime/shared_wallet/coordinator.sqlite3 \
  --live-profile cd90=com.luke.polymarket.cd90-live.service=/srv/polymarket-live/runtime/cd90_live=com.luke.polymarket.cd90-live-hot-standby.service \
  --live-profile zockdo_full_wallet=com.luke.polymarket.zockdo-live.service=/srv/polymarket-live/runtime/zockdo_live=com.luke.polymarket.zockdo-live-hot-standby.service \
  --live-profile wallet_9506_full_wallet=com.luke.polymarket.wallet-9506-live.service=/srv/polymarket-live/runtime/wallet_9506_live=com.luke.polymarket.wallet-9506-live-hot-standby.service
